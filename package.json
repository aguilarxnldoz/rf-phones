{
	"name": "rf-phones",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "next build",
		"check": "bun run lint && bun run typecheck",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:reset": "docker compose down -v && docker compose up -d && sleep 2 && bun run db:push",
		"dev": "./scripts/dev.sh",
		"dev:next": "next dev --turbo",
		"docker:up": "./scripts/dev-services.sh",
		"docker:down": "docker compose down",
		"docker:reset": "docker compose down -v",
		"docker:logs": "docker compose logs -f",
		"docker:psql": "docker compose exec postgres psql -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-rf-phones}",
		"format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
		"format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"preview": "next build && next start",
		"start": "next start",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@auth/drizzle-adapter": "^1.11.3",
		"@better-auth/infra": "^0.3.7",
		"@t3-oss/env-nextjs": "^0.13.11",
		"better-auth": "^1.6.28",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"framer-motion": "^13.1.0",
		"lucide-react": "^1.31.0",
		"next": "^16.3.1",
		"postgres": "^3.4.9",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.6",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.3.1",
		"eslint-plugin-drizzle": "^0.2.3",
		"postcss": "^8.5.26",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.67.0"
	},
	"ct3aMetadata": {
		"initVersion": "7.40.0"
	}
}
